{
  "nix.enableLanguageServer": true,
  "nix.serverPath": "nixd",
  "nix.serverSettings": {
    "nixd": {
      "nixpkgs": {
        "expr": "import (builtins.getFlake \"/home/stefan/nixos\").inputs.nixpkgs { }"
      },
      "formatting": {
        "command": ["nixfmt"]
      },
      "options": {
        "nixos": {
          "expr": "(builtins.getFlake \"/home/stefan/nixos\").nixosConfigurations.wsl.options"
        },
        "home-manager": {
          "expr": "(builtins.getFlake \"/home/stefan/nixos\").nixosConfigurations.my-host.options.home-manager.users.type.getSubOptions []"
        }
      }
    }
  }
}